{
  "name": "@yaoyu/geo-engine-three",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "three.js scene adapter for @yaoyu/geo-engine: extruded region plates, drill transitions, labels, points, picking.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --sourcemap --external:three --external:three/* --external:@yaoyu/geo-engine --outfile=dist/index.js && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "playground": "esbuild playground/main.ts --bundle --format=iife --outdir=playground/dist --servedir=playground --serve=5199",
    "playground:build": "esbuild playground/main.ts --bundle --format=iife --outdir=playground/dist",
    "visual-check": "node scripts/visual-check.mjs",
    "soak": "node scripts/soak.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@yaoyu/geo-engine": "workspace:*"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "three": "0.187.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  }
}
