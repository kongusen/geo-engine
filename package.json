{
  "name": "geodive-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "playground": "pnpm --filter @geodive/three playground",
    "visual-check": "pnpm --filter @geodive/three visual-check",
    "soak": "pnpm --filter @geodive/three soak",
    "pack:to": "node scripts/pack.mjs",
    "version:set": "node scripts/set-version.mjs"
  },
  "license": "MIT"
}
